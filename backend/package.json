{
  "name": "meson-reabasto-bot-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo": "node scripts/demo.mjs",
    "stop": "node scripts/stop.mjs",
    "dev": "wrangler dev --local --ip 127.0.0.1 --port 8787",
    "db:migrate:local": "wrangler d1 migrations apply reto2-demo --local",
    "e2e:local": "node scripts/e2e-local.mjs"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "vitest": "4.1.12",
    "wrangler": "4.168.0"
  },
  "dependencies": {
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "engines": {
    "node": ">=22.13"
  }
}
